# Secrets only. Non-secret settings live in config.yaml (override them here with e.g. LASTFM__RATE_LIMIT=1).
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret
# Clients must send this in the X-API-Key header (min 16 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=change_me_to_a_long_random_string
